{
  "version": 1,
  "listen": {"host": "127.0.0.1", "port": 11301, "request_timeout_secs": 30, "max_connections": 4},
  "token_file": "~/.config/pebble/ingress.token",
  "state_dir": "~/.local/state/pebble/audio",
  "max_body_bytes": 8388608,
  "max_pending": 128,
  "max_archive_bytes": 10737418240,
  "min_free_bytes": 1073741824,
  "retry_delays_secs": [2, 10, 30],
  "ffmpeg": "ffmpeg",
  "node": "node",
  "mai": {
    "agent_utils_dir": "~/src/agent-utils",
    "endpoint_file": "~/.config/pebble/mai-endpoint",
    "key_file": "~/.config/pebble/mai-key",
    "deployment": "example-mai-transcribe-2",
    "language": "en",
    "timeout_secs": 60,
    "max_audio_secs": 120
  },
  "forward": {
    "url": "https://hooks.example.invalid/pebble",
    "timeout_secs": 60
  },
  "chime": {
    "enabled": true,
    "argv": ["pebble-chime"],
    "server": "localhost",
    "pitch": 523.25,
    "duration": 0.06,
    "gain": 0.10
  }
}
